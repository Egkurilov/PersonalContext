{"$defs": {"BrowserProvenance": {"additionalProperties": false, "properties": {"collector": {"const": "browser", "title": "Collector", "type": "string"}, "collector_version": {"maxLength": 32, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "title": "Collector Version", "type": "string"}, "import_id": {"title": "Import Id", "type": "null"}}, "required": ["collector", "collector_version", "import_id"], "title": "BrowserProvenance", "type": "object"}, "WebPayload": {"additionalProperties": false, "properties": {"domain": {"maxLength": 253, "minLength": 1, "title": "Domain", "type": "string"}, "url": {"maxLength": 8192, "minLength": 1, "title": "Url", "type": "string"}, "title": {"anyOf": [{"maxLength": 512, "type": "string"}, {"type": "null"}], "default": null, "title": "Title"}}, "required": ["domain", "url"], "title": "WebPayload", "type": "object"}}, "additionalProperties": false, "allOf": [{"if": {"properties": {"granularity": {"const": "point"}}, "required": ["granularity"]}, "then": {"properties": {"duration_ms": {"type": "null"}}}}], "properties": {"granularity": {"const": "point", "title": "Granularity", "type": "string"}, "duration_ms": {"anyOf": [{"maximum": 900000, "minimum": 0, "type": "integer"}, {"type": "null"}], "title": "Duration Ms"}, "started_at": {"format": "date-time", "maxLength": 128, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$", "title": "Started At", "type": "string"}, "ended_at": {"anyOf": [{"format": "date-time", "maxLength": 128, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$", "type": "string"}, {"type": "null"}], "title": "Ended At"}, "observed_at": {"format": "date-time", "maxLength": 128, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$", "title": "Observed At", "type": "string"}, "schema_version": {"const": 1, "title": "Schema Version", "type": "integer"}, "event_id": {"maxLength": 36, "minLength": 36, "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[47][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$", "title": "Event Id", "type": "string"}, "device_id": {"maxLength": 36, "minLength": 36, "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[47][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$", "title": "Device Id", "type": "string"}, "source_id": {"maxLength": 36, "minLength": 36, "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[47][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$", "title": "Source Id", "type": "string"}, "source_event_key": {"pattern": "^[A-Za-z0-9_-]{1,64}$", "title": "Source Event Key", "type": "string"}, "quality": {"enum": ["measured", "imported", "estimated", "unknown"], "title": "Quality", "type": "string"}, "timezone": {"maxLength": 128, "minLength": 1, "title": "Timezone", "type": "string"}, "policy_version": {"maximum": 9007199254740991, "minimum": 1, "title": "Policy Version", "type": "integer"}, "consent_scope": {"const": "metadata", "title": "Consent Scope", "type": "string"}, "provenance": {"$ref": "#/$defs/BrowserProvenance"}, "kind": {"const": "web_visit", "title": "Kind", "type": "string"}, "payload": {"$ref": "#/$defs/WebPayload"}}, "required": ["granularity", "duration_ms", "started_at", "ended_at", "observed_at", "schema_version", "event_id", "device_id", "source_id", "source_event_key", "quality", "timezone", "policy_version", "consent_scope", "provenance", "kind", "payload"], "title": "WebVisit", "type": "object", "$schema": "https://json-schema.org/draft/2020-12/schema"}
